# =====================================================
# STRIPE PAYMENT GATEWAY CONFIGURATION
# =====================================================
# To enable Stripe payments, add your Stripe API keys below.
# Get your keys from: https://dashboard.stripe.com/apikeys
#
# For testing, use test keys (start with sk_test_ and pk_test_)
# For production, use live keys (start with sk_live_ and pk_live_)
# =====================================================

# Stripe Secret Key (Server-side) - Required for processing payments
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Publishable Key (Client-side) - Used in frontend if needed
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret (Optional) - For webhook event verification
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =====================================================
# OTHER CONFIGURATION (Example)
# =====================================================
# MONGODB_URI=mongodb://localhost:27017/autocustomizer
# SESSION_SECRET=your-session-secret
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FRONTEND_URL=http://localhost:5173
